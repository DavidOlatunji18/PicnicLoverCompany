generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  phone       String
  date        String
  startTime   String
  guests      Int
  theme       String
  location    String
  addons      String?
  message     String?
  hearAbout   String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}
